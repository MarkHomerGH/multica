;; Grandin Multica agent. HOME, WORKROOT and TMP are supplied by sandbox-exec.
;; Hazmat containment/darwin/sbpl.go:45-48: default deny is first.
(version 1)
(deny default)

;; Hazmat sbpl.go:50-73: process and same-sandbox control.
(allow process-exec (subpath "/usr/bin"))
(allow process-exec (subpath "/bin"))
(allow process-exec (subpath "/usr/libexec"))
(allow process-exec (subpath "/Library/Developer/CommandLineTools"))
(allow process-exec (subpath "/usr/local/multica-agent/bin"))
(allow process-exec (subpath (param "WORKROOT")))
(allow process-exec (subpath (param "TMP")))
(allow process-fork)
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))

;; Hazmat sbpl.go:75-77: V8/Bun startup queries.
(allow sysctl-read)
(allow system-info)

;; Hazmat sbpl.go:196-261: terminal, Mach and IPC needed by Go/Bun.
(allow pseudo-tty)
(allow file-ioctl)
(allow file-read* file-write* (literal "/dev/tty"))
(allow file-read* file-write* (literal "/dev/ptmx"))
(allow file-read* file-write* (regex #"/dev/ttys[0-9]+"))
(allow mach-lookup (global-name "com.apple.system.logger"))
(allow mach-lookup (global-name "com.apple.CoreServices.coreservicesd"))
(allow mach-lookup (global-name "com.apple.system.notification_center"))
(allow mach-lookup (global-name "com.apple.trustd"))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.api"))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow mach-lookup (global-name "com.apple.system.DirectoryService.libinfo_v1"))
(allow mach-lookup (global-name "com.apple.system.DirectoryService.membership_v1"))
(allow mach-lookup (global-name "com.apple.mDNSResponder"))
(allow mach-host*)

;; Hazmat sbpl.go:79-125, 183-193: system loader, DNS, developer tools.
;; Parent literals allow traversal/realpath only, not directory contents.
(allow file-read* (literal "/"))
(allow file-read* (literal "/private"))
(allow file-read* (literal "/var"))
(allow file-read* (literal "/var/select"))
(allow file-read* (literal "/tmp"))
(allow file-read* (literal "/etc"))
(allow file-read* (literal "/usr"))
(allow file-read* (literal "/usr/local"))
(allow file-read* (literal "/System"))
(allow file-read* (literal "/Library"))
(allow file-read* (literal "/Library/Developer"))
(allow file-read* (subpath "/usr/lib"))
(allow file-read* (subpath "/usr/share"))
(allow file-read* (subpath "/System/Library"))
(allow file-read* (subpath "/System/Cryptexes"))
(allow file-read* (subpath "/System/Volumes/Preboot/Cryptexes"))
(allow file-read* (subpath "/Library/Frameworks"))
(allow file-read* (subpath "/Library/Developer/CommandLineTools"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/private/var/select"))
(allow file-read* (subpath "/private/var/db/timezone"))
(allow file-read* (subpath "/private/var/run"))
(allow file-read* (literal "/private/var/db/xcode_select_link"))
(allow file-read* (literal "/dev/urandom"))
(allow file-read* (literal "/dev/null"))
(allow file-read* (literal "/dev/zero"))
(allow file-write* (literal "/dev/null"))
(allow file-read-metadata (literal "/Users"))
;; OpenCode reads its cwd when the daemon probes its version from HOME.
;; This literal permits the HOME entry/listing, not descendant contents.
(allow file-read* (literal (param "HOME")))
(allow file-read-metadata (literal "/private/tmp"))
(allow file-read-metadata (literal "/private/var/folders"))

;; Hazmat sbpl.go:99-125, 133-138: explicit read-only executable roots.
(allow file-read* (subpath "/usr/local/multica-agent"))
(allow file-read* (subpath "/usr/bin"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/usr/libexec"))

;; Hazmat sbpl.go:140-178, 272-286: explicit writable roots only.
;; ~/.multica is the CLI config path (server/internal/cli/config.go:13).
;; OpenCode uses XDG config/data/state/cache; setup-agent-account.sh:53-54
;; installs its configuration beneath ~/.config/opencode. Hazmat's
;; containment/agent_home_manifest.go:198 also records ~/.opencode state.
(allow file-read* file-write* (subpath (param "WORKROOT")))
(allow file-read* file-write* (subpath (param "TMP")))
(allow file-read* file-write* (subpath (string-append (param "HOME") "/.config/opencode")))
(allow file-read* file-write* (subpath (string-append (param "HOME") "/.local/share/opencode")))
(allow file-read* file-write* (subpath (string-append (param "HOME") "/.local/state/opencode")))
(allow file-read* file-write* (subpath (string-append (param "HOME") "/.cache")))
(allow file-read* file-write* (subpath (string-append (param "HOME") "/.multica")))
(allow file-read* file-write* (subpath (string-append (param "HOME") "/.opencode")))
;; XDG parents must be traversable for their named children.
(allow file-read-metadata (literal (string-append (param "HOME") "/.config")))
(allow file-read-metadata (literal (string-append (param "HOME") "/.local")))
(allow file-read-metadata (literal (string-append (param "HOME") "/.local/share")))
(allow file-read-metadata (literal (string-append (param "HOME") "/.local/state")))

;; Scope outbound sockets to the board and Ollama. DNS resolver traffic needs
;; another destination, so Seatbelt denies it even when pf cannot see it.
(allow network-outbound (remote ip "localhost:8080"))
(allow network-outbound (remote ip "localhost:11434"))
;; Keep the daemon's loopback health listener (default port 19514), but never
;; let the agent claim the board or Ollama listener during a restart.
(allow network-inbound (local tcp "localhost:*"))
(allow network-bind (local tcp "localhost:*"))
(deny network-bind (local tcp "localhost:8080"))
(deny network-bind (local tcp "localhost:11434"))
(deny network-inbound (local tcp "localhost:8080"))
(deny network-inbound (local tcp "localhost:11434"))

;; Hazmat sbpl.go:299-304 and pathpolicy/pathpolicy.go:10-54:
;; LAST rules deny agent-home credential paths (last match wins).
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.ssh")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.aws")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.gnupg")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/Library/Keychains")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.config/gh")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.docker")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.kube")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.netrc")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.m2/settings.xml")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.config/gcloud")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.azure")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.oci")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.cache/huggingface/token")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.cache/huggingface/stored_tokens")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.ollama/id_ed25519")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.jupyter")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.local/share/jupyter/runtime")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.langsmith")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.config/amp")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.config/devin")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.config/kilo")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.kimi-code")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.kimi")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.kiro")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.vibe")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.traecli")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.config/crush")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.local/share/crush")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.openclaw")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.qoder")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.copilot")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.deepseek")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.codewhale")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.grok")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.openhands")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.continue")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.cline")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.aider.conf.yml")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.config/goose")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.local/share/goose")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/.local/state/goose")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/Library/Application Support/Claude")))
(deny file-read* file-write* (subpath (string-append (param "HOME") "/Library/Application Support/Cursor")))
